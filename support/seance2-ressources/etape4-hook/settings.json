{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(git status)",
      "Bash(git diff*)"
    ],
    "ask": [
      "Bash(pip install*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Edit(./tests/test_app.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests.sh"
          }
        ]
      }
    ]
  }
}
